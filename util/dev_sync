#!/usr/bin/env bash
set -euo pipefail

# dev_sync - Zero-Mac-sudo, DETERMINISTIC macOS <-> Ubuntu (Parallels) sync
# =============================================================================
# Drop-in replacement for ~/.local/bin/dev_sync. The original is left untouched.
#
# WHY THIS EXISTS (root cause of "the sync keeps breaking"):
#   The VM runs on BRIDGED networking (net0 type=bridged). In bridge mode the VM
#   pulls a DHCP lease from whatever *physical* LAN the Mac is on, so BOTH the
#   Mac's and the VM's IPs change every time you switch networks (home Wi-Fi ->
#   hotspot -> office), and the Parallels bridge goes stale after sleep. That is
#   non-deterministic by construction, which is why the original script needed a
#   3-step recovery ladder and still broke intermittently.
#
#   >>> PERMANENT ROOT-CAUSE FIX (one-time, do this in Parallels GUI): <<<
#   Switch the VM's network from "Bridged" to "Shared (NAT)".
#     Parallels GUI -> VM -> Configure -> Hardware -> Network -> Source: Shared.
#   Shared mode puts the VM on Parallels' private 10.211.55.0/24 net with its own
#   DHCP that DOES NOT change when the Mac's physical network changes. Optionally
#   reserve a static lease so the IP never moves. With a stable IP the churn - and
#   the whole reason this sync kept breaking - disappears. (Changing Parallels is
#   left to you; this script works under both modes.)
#
# WHAT CHANGED vs the original (the two goals):
#   (a) ZERO Mac sudo. The original's ONLY Mac-sudo code was update_hosts_file():
#         sudo cp /etc/hosts /etc/hosts.bak
#         sudo sed -i '' .../etc/hosts
#         echo ... | sudo tee -a /etc/hosts
#         sudo dscacheutil -flushcache ; sudo killall -HUP mDNSResponder
#       That block is REMOVED. /etc/hosts is root:wheel (0644) so it cannot be
#       edited without sudo -> it breaks the moment the account is Standard.
#       Mac-side name resolution now lives entirely in ~/.ssh/config (user-owned)
#       plus SSH LocalForward tunnels, so VM services are reachable at a STABLE
#       localhost:PORT that never depends on /etc/hosts, DNS, or the VM's IP.
#       (Also: /etc/hosts on macOS is owned by focusd's dns-block plugin - granting
#       a Standard account write access to it would undermine that blocklist, so we
#       deliberately do NOT reintroduce /etc/hosts writes via sudoers/chown.)
#   (b) DETERMINISTIC. Services ride an SSH tunnel (localhost:PORT), which
#       reconnects to the current IP every run instead of relying on a cached
#       /etc/hosts entry that silently goes stale. Optional `files` subcommand
#       replaces the flaky Parallels shared folder (prl_fs) with rsync-over-SSH,
#       which runs identically every time.
#
# WHAT STILL USES sudo - and why that's fine under a Standard Mac account:
#   The guest-side updates (Ubuntu /etc/hosts 'mymac', NetworkManager restarts)
#   use the *Ubuntu VM's* sudo over SSH (UBUNTU_SUDO_PASSWORD / `prlctl exec sudo`).
#   That is the GUEST's root, not the Mac's. Demoting the Mac account to Standard
#   does not touch it - inside the VM you are still root.
#
# Net effect: daily dev + VM sync run entirely as a Standard (non-admin) Mac user.
# =============================================================================

# ---- Configuration ----------------------------------------------------------
VM_NAME="Ubuntu 24.04.3 ARM64"
SSH_CONFIG="$HOME/.ssh/config"
SSH_HOST_ENTRY="ubuntu"                 # user-owned; how the Mac reaches the VM
PRLCTL="/usr/local/bin/prlctl"
NETWORK_INTERFACE="enp0s5"              # Ubuntu VM NIC (ip addr)
NMCLI_CONNECTION=""                     # auto-detected if empty
UBUNTU_MCP_CONFIG="/home/parallels/.claude.json"
MCP_PORT="9223"                         # Chrome DevTools port on the Mac (>1024, no sudo)
UBUNTU_HOSTNAME_FOR_MAC="mymac"         # name the VM uses to reach the Mac

# VM HTTP services exposed to the Mac as STABLE localhost tunnels (name:port).
# Reached from the Mac at http://localhost:<port> via SSH LocalForward - no
# /etc/hosts, no DNS, survives IP churn.
VM_SERVICES=("Flowise:3100")

# Managed marker so we can idempotently rewrite our block in ~/.ssh/config.
SSH_BLOCK_BEGIN="# >>> dev_sync managed (LocalForward tunnels) >>>"
SSH_BLOCK_END="# <<< dev_sync managed <<<"

# SSH options for reaching the VM. StrictHostKeyChecking=accept-new auto-trusts
# the VM's key on a NEW IP. In bridged mode the VM's IP changes on every network
# switch, which changes its host key entry - and the FIRST connect to the new IP
# otherwise dies with "Host key verification failed". That is a primary cause of
# the intermittent "sync keeps breaking". accept-new makes it deterministic, with
# zero Mac sudo. (It's the owner's own VM on a private link - safe to auto-accept.)
SSH_OPTS=(-o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new)

# Optional deterministic file sync (prl_fs shared-folder replacement).
# Trailing slash on SRC = "copy contents of". DEST must be a USER-OWNED guest
# path (NOT /media/psf/... which is the flaky auto-(un)mounted shared folder).
FILESYNC_SRC="$HOME/shared/"
FILESYNC_DEST="/home/parallels/shared/"

# ---- Colors -----------------------------------------------------------------
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
print_error()   { echo -e "${RED}ERROR: $*${NC}" >&2; }
print_success() { echo -e "${GREEN}$*${NC}"; }
print_warning() { echo -e "${YELLOW}WARNING: $*${NC}"; }
print_info()    { echo -e "${BLUE}$*${NC}"; }

# ---- Network mode awareness (report determinism) ----------------------------
vm_net_mode() {
    "$PRLCTL" list -i "$VM_NAME" 2>/dev/null \
        | grep -oE 'net0.*type=[a-z-]+' | grep -oE 'type=[a-z-]+' | cut -d= -f2 | head -1
}

# ---- Bring the VM up (no Mac sudo: prlctl talks to the root dispatcher) ------
# Deterministic "the VM comes up every run": resume a suspended VM, start a
# stopped one, then wait until guest exec works. Uses zero Mac sudo.
ensure_vm_running() {
    local st
    st=$("$PRLCTL" status "$VM_NAME" 2>/dev/null | awk '{print $NF}')
    case "$st" in
        running)        print_info "VM already running" ;;
        suspended|paused)
            print_info "Resuming VM (no Mac sudo)..."
            "$PRLCTL" resume "$VM_NAME" >/dev/null 2>&1 || "$PRLCTL" start "$VM_NAME" >/dev/null 2>&1 || true ;;
        *)
            print_info "VM status '${st:-unknown}' - starting (no Mac sudo)..."
            "$PRLCTL" start "$VM_NAME" >/dev/null 2>&1 || true ;;
    esac
    local i=0
    while [[ $i -lt 24 ]]; do
        "$PRLCTL" exec "$VM_NAME" true >/dev/null 2>&1 && { print_success "OK VM is up"; return 0; }
        sleep 5; ((i++)); print_info "  waiting for VM to be ready... ($((i*5))s)"
    done
    print_error "VM did not become ready in time"; return 1
}

# ---- Guest IP with auto-recovery (guest-side sudo only; no Mac sudo) ---------
get_nmcli_connection_name() {
    if [[ -n "$NMCLI_CONNECTION" ]]; then echo "$NMCLI_CONNECTION"; return 0; fi
    local conn
    conn=$("$PRLCTL" exec "$VM_NAME" nmcli -t -f NAME,DEVICE connection show 2>/dev/null \
            | grep ":${NETWORK_INTERFACE}$" | cut -d: -f1 || true)
    [[ -n "$conn" ]] && echo "$conn" || echo "$NETWORK_INTERFACE"
}

get_vm_ip() {
    local vm_ip retry=0 max=3
    if ! "$PRLCTL" list | grep -q "$VM_NAME"; then
        print_error "VM '$VM_NAME' is not running. Start it: $PRLCTL start \"$VM_NAME\" (no Mac sudo)"
        exit 1
    fi
    while [[ $retry -le $max ]]; do
        vm_ip=$("$PRLCTL" exec "$VM_NAME" ip -4 addr show "$NETWORK_INTERFACE" 2>/dev/null \
                | grep -o 'inet [0-9.]*' | awk '{print $2}' || true)
        [[ -n "$vm_ip" ]] && { echo "$vm_ip"; return 0; }
        local conn; conn=$(get_nmcli_connection_name)
        case $retry in
            0) print_warning "VM has no IPv4 - restarting NetworkManager (guest sudo)..."
               "$PRLCTL" exec "$VM_NAME" sudo systemctl restart NetworkManager 2>/dev/null || true; sleep 5 ;;
            1) print_info "Cycling nmcli connection (guest sudo)..."
               "$PRLCTL" exec "$VM_NAME" sudo nmcli connection down "$conn" 2>/dev/null || true; sleep 2
               "$PRLCTL" exec "$VM_NAME" sudo nmcli connection up "$conn" 2>/dev/null || true; sleep 5 ;;
            2) print_info "Toggling virtual NIC to jolt the bridge (no Mac sudo)..."
               "$PRLCTL" set "$VM_NAME" --device-disconnect net0 >/dev/null 2>&1 || true; sleep 2
               "$PRLCTL" set "$VM_NAME" --device-connect net0 >/dev/null 2>&1 || true; sleep 3
               "$PRLCTL" exec "$VM_NAME" sudo systemctl start NetworkManager 2>/dev/null || true; sleep 2
               "$PRLCTL" exec "$VM_NAME" sudo nmcli connection up "$conn" 2>/dev/null || true; sleep 6 ;;
            *) print_error "Auto-recovery failed - VM still has no IPv4."
               print_info "If this recurs, switch the VM to Shared (NAT) networking (see header)."
               exit 1 ;;
        esac
        ((retry++))
    done
}

get_macos_ip() {
    local ip; ip=$(ipconfig getifaddr en0 2>/dev/null || true)
    [[ -z "$ip" ]] && ip=$(ipconfig getifaddr en1 2>/dev/null || true)
    [[ -z "$ip" ]] && { print_error "Could not determine macOS LAN IP (en0/en1)"; exit 1; }
    echo "$ip"
}

# ---- Mac-side resolution: ~/.ssh/config ONLY (user-owned, NO sudo) ----------
get_ssh_config_ip() {
    [[ -f "$SSH_CONFIG" ]] || { echo ""; return; }
    awk '
        /^Host ubuntu$/ { found=1; next }
        found && /^Host / { exit }
        found && /^[[:space:]]*HostName / { print $2; exit }
    ' "$SSH_CONFIG"
}

update_ssh_config() {
    local new_ip=$1 current_ip
    current_ip=$(get_ssh_config_ip)
    if [[ -z "$current_ip" ]]; then
        print_error "No 'Host ubuntu' entry in $SSH_CONFIG - add one first."
        exit 1
    fi
    cp "$SSH_CONFIG" "$SSH_CONFIG.bak"   # user-owned backup, no sudo
    if [[ "$current_ip" != "$new_ip" ]]; then
        print_info "SSH config HostName: $current_ip -> $new_ip"
        sed -i '' "/^Host ubuntu$/,/^Host / s/^\([[:space:]]*HostName \).*/\1$new_ip/" "$SSH_CONFIG"
        ssh-keygen -R "$current_ip" 2>/dev/null || true
        ssh-keygen -R "$SSH_HOST_ENTRY" 2>/dev/null || true
    else
        print_info "SSH config HostName already correct ($new_ip)"
    fi
    _write_ssh_localforward_block
    print_success "OK ~/.ssh/config updated (no sudo)"
}

# Idempotently (re)write a managed block that tunnels each VM service to a stable
# localhost:PORT on the Mac. Deterministic: rides the SSH connection, so it always
# points at the CURRENT VM IP without touching /etc/hosts or DNS.
_write_ssh_localforward_block() {
    local tmp; tmp=$(mktemp)
    awk -v b="$SSH_BLOCK_BEGIN" -v e="$SSH_BLOCK_END" '
        $0==b {skip=1} skip && $0==e {skip=0; next} !skip {print}
    ' "$SSH_CONFIG" > "$tmp"
    {
        echo ""
        echo "$SSH_BLOCK_BEGIN"
        echo "Host ubuntu"
        for svc in "${VM_SERVICES[@]}"; do
            local port="${svc##*:}"
            echo "  LocalForward ${port} localhost:${port}"
        done
        echo "  LocalForward ${MCP_PORT} localhost:${MCP_PORT}"
        echo "$SSH_BLOCK_END"
    } >> "$tmp"
    mv "$tmp" "$SSH_CONFIG"
}

# ---- Guest-side updates (use the VM's OWN sudo over SSH - not the Mac's) -----
get_ubuntu_sudo_password() {
    if [[ -n "${UBUNTU_SUDO_PASSWORD:-}" ]]; then echo "$UBUNTU_SUDO_PASSWORD"; return 0; fi
    local creds="$HOME/.creds/local.sh"
    if [[ -f "$creds" ]]; then
        # shellcheck disable=SC1090
        source "$creds"
        [[ -n "${UBUNTU_SUDO_PASSWORD:-}" ]] && { echo "$UBUNTU_SUDO_PASSWORD"; return 0; }
    fi
    print_error "UBUNTU_SUDO_PASSWORD not set (env or ~/.creds/local.sh)"; exit 1
}

update_ubuntu_hosts_file() {
    local mac_ip=$1 sudo_pass
    sudo_pass=$(get_ubuntu_sudo_password)
    print_info "Updating Ubuntu /etc/hosts ($UBUNTU_HOSTNAME_FOR_MAC -> $mac_ip) via guest sudo..."
    local cmd="echo '$sudo_pass' | sudo -S sed -i '/^[0-9.][0-9.]*[[:space:]][[:space:]]*${UBUNTU_HOSTNAME_FOR_MAC}\$/d' /etc/hosts && echo '$mac_ip $UBUNTU_HOSTNAME_FOR_MAC' | sudo -S tee -a /etc/hosts >/dev/null"
    if ssh "${SSH_OPTS[@]}" "$SSH_HOST_ENTRY" "$cmd" 2>/dev/null; then
        print_success "OK Ubuntu /etc/hosts: $UBUNTU_HOSTNAME_FOR_MAC -> $mac_ip"
    else
        print_error "Failed to update Ubuntu /etc/hosts (check 'ssh ubuntu' + UBUNTU_SUDO_PASSWORD)"; exit 1
    fi
}

update_ubuntu_mcp_config() {
    local mac_ip=$1
    print_info "Updating Ubuntu MCP browserUrl -> http://$mac_ip:$MCP_PORT ..."
    if ! ssh -q "${SSH_OPTS[@]}" "$SSH_HOST_ENTRY" "jq -e '.mcpServers' $UBUNTU_MCP_CONFIG" >/dev/null 2>&1; then
        local add="jq '. + {\"mcpServers\": {\"chrome-devtools\": {\"type\": \"stdio\", \"command\": \"/home/parallels/.local/bin/npx-mcp\", \"args\": [\"chrome-devtools-mcp@latest\", \"--browserUrl=http://$mac_ip:$MCP_PORT\"], \"env\": {}}}}' $UBUNTU_MCP_CONFIG > ${UBUNTU_MCP_CONFIG}.tmp && mv ${UBUNTU_MCP_CONFIG}.tmp $UBUNTU_MCP_CONFIG"
        ssh -q "${SSH_OPTS[@]}" "$SSH_HOST_ENTRY" "$add" 2>/dev/null \
            && print_success "OK created MCP config" || { print_error "Failed to create MCP config"; exit 1; }
        return 0
    fi
    local upd="jq '.mcpServers.\"chrome-devtools\".args = [.mcpServers.\"chrome-devtools\".args[] | if startswith(\"--browserUrl=\") then \"--browserUrl=http://$mac_ip:$MCP_PORT\" else . end]' $UBUNTU_MCP_CONFIG > ${UBUNTU_MCP_CONFIG}.tmp && mv ${UBUNTU_MCP_CONFIG}.tmp $UBUNTU_MCP_CONFIG"
    ssh -q "${SSH_OPTS[@]}" "$SSH_HOST_ENTRY" "$upd" 2>/dev/null \
        && print_success "OK Ubuntu MCP browserUrl updated" || { print_error "Failed to update MCP config (is jq installed on Ubuntu?)"; exit 1; }
}

# ---- Chrome MCP on the Mac (port 9223, unprivileged - no sudo) ---------------
ensure_chrome_mcp_running() {
    if ! run_chrome_mcp status >/dev/null 2>&1; then
        print_warning "Chrome MCP not running - starting..."
        run_chrome_mcp start >/dev/null 2>&1 && sleep 2 \
            && print_success "OK Chrome MCP started" || { print_error "Failed to start Chrome MCP (run_chrome_mcp start)"; exit 1; }
    fi
}

# ---- Reachability (deterministic; no Mac sudo anywhere) ---------------------
wait_reachable() {
    local ip=$1 max=${2:-30} elapsed=0
    while [[ $elapsed -lt $max ]]; do
        ping -c 1 -W 2 "$ip" >/dev/null 2>&1 && { print_success "OK VM reachable at $ip (${elapsed}s)"; return 0; }
        sleep 5; elapsed=$((elapsed+5)); print_info "  waiting... (${elapsed}s)"
    done
    return 1
}

# =============================================================================
# Subcommand: status
# =============================================================================
cmd_status() {
    echo; echo "=== dev_sync status (zero Mac sudo) ==="; echo
    local mode; mode=$(vm_net_mode)
    if [[ "$mode" == "bridged" ]]; then
        print_warning "VM network mode: bridged  -> IP will churn on network changes (see header for the permanent Shared/NAT fix)"
    else
        print_success "VM network mode: ${mode:-unknown}  -> stable IP (deterministic)"
    fi
    ensure_vm_running || exit 1
    local vm_ip mac_ip ssh_ip
    vm_ip=$(get_vm_ip); mac_ip=$(get_macos_ip); ssh_ip=$(get_ssh_config_ip)
    echo "  macOS IP        : $mac_ip"
    echo "  VM IP           : $vm_ip"
    local s="OUT OF SYNC"; [[ "$ssh_ip" == "$vm_ip" ]] && s="in sync"
    echo "  ~/.ssh/config   : ${ssh_ip:-<none>}  [$s]"
    if run_chrome_mcp status >/dev/null 2>&1; then echo "  Chrome MCP      : running (localhost:$MCP_PORT)"; else echo "  Chrome MCP      : NOT running"; fi
    echo
    print_info "VM services reachable from the Mac at (SSH tunnel; open with 'ssh ubuntu'):"
    for svc in "${VM_SERVICES[@]}"; do echo "    ${svc%%:*}: http://localhost:${svc##*:}"; done
    echo
    [[ "$ssh_ip" == "$vm_ip" ]] && print_success "Overall: in sync" || print_warning "Overall: run 'dev_sync sync'"
}

# =============================================================================
# Subcommand: sync
# =============================================================================
cmd_sync() {
    echo; print_info "=== dev_sync sync (no Mac sudo) ==="; echo
    local mode; mode=$(vm_net_mode)
    [[ "$mode" == "bridged" ]] && print_warning "bridged mode detected - for a sync that NEVER breaks, switch the VM to Shared/NAT (see header)."

    ensure_vm_running || exit 1

    local vm_ip mac_ip
    vm_ip=$(get_vm_ip); mac_ip=$(get_macos_ip)
    print_info "VM IP: $vm_ip   macOS IP: $mac_ip"; echo

    if ! wait_reachable "$vm_ip" 15; then
        print_warning "VM not immediately reachable - suspend/resume to re-handshake bridge (no Mac sudo)..."
        "$PRLCTL" suspend "$VM_NAME" >/dev/null 2>&1 && "$PRLCTL" resume "$VM_NAME" >/dev/null 2>&1 || true
        vm_ip=$(get_vm_ip)
        wait_reachable "$vm_ip" 45 || { print_error "VM unreachable. If recurring, switch to Shared/NAT networking."; exit 1; }
    fi

    ensure_chrome_mcp_running; echo

    print_info "=== macOS side (user-owned files only) ==="
    update_ssh_config "$vm_ip"            # ~/.ssh/config + LocalForward tunnels; NO /etc/hosts, NO sudo
    echo

    print_info "=== Ubuntu side (no sudo) ==="
    update_ubuntu_mcp_config "$mac_ip"
    echo

    print_success "=== Ready (0 Mac sudo used) ==="
    print_info "macOS -> VM : ssh ubuntu"
    for svc in "${VM_SERVICES[@]}"; do print_info "VM service : ${svc%%:*} at http://localhost:${svc##*:} (open an 'ssh ubuntu' session to bring the tunnel up)"; done
    print_info "VM -> macOS : Chrome MCP at http://$mac_ip:$MCP_PORT"
    echo
}

# =============================================================================
# Subcommand: files  (DETERMINISTIC replacement for the Parallels shared folder)
# ---------------------------------------------------------------------------
# The Parallels shared folder (prl_fs, e.g. /media/psf/...) auto-(un)mounts across
# VM sleep/restart and drifts on ownership - the classic "sync keeps breaking".
# rsync-over-SSH runs identically every time, targets a USER-OWNED guest path, and
# needs NO Mac sudo (and no guest sudo, since DEST is user-owned).
# =============================================================================
cmd_files() {
    command -v rsync >/dev/null 2>&1 || { print_error "rsync not found on the Mac"; exit 1; }
    ssh "${SSH_OPTS[@]}" "$SSH_HOST_ENTRY" "mkdir -p '$FILESYNC_DEST'" 2>/dev/null \
        || { print_error "Cannot reach VM over SSH ('ssh ubuntu'). Run 'dev_sync sync' first."; exit 1; }
    print_info "rsync $FILESYNC_SRC -> ${SSH_HOST_ENTRY}:$FILESYNC_DEST (user-level, no sudo)"
    rsync -az --delete --human-readable \
        -e "ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new" \
        "$FILESYNC_SRC" "${SSH_HOST_ENTRY}:${FILESYNC_DEST}" \
        && print_success "OK files synced (deterministic; same result every run)" \
        || { print_error "rsync failed"; exit 1; }
}

# =============================================================================
cmd_help() {
    cat <<EOF
dev_sync - zero-Mac-sudo, deterministic macOS <-> Ubuntu VM sync

USAGE:
    dev_sync {status|sync|files|help}

    status   Show VM/mac IPs, ssh-config sync state, network mode, service URLs
    sync     Sync VM IP into ~/.ssh/config (+ LocalForward tunnels) and update the
             guest side. Uses NO Mac sudo. Guest-side edits use the VM's own sudo.
    files    Deterministic host->guest file sync via rsync-over-SSH (replaces the
             flaky Parallels shared folder). Edit FILESYNC_SRC/DEST at the top.
    help     This message.

ZERO MAC SUDO:
    Mac-side name resolution is ~/.ssh/config only (user-owned). VM HTTP services
    are reached at a stable http://localhost:PORT via SSH LocalForward - no
    /etc/hosts, so nothing here needs 'sudo'. Works fine as a Standard user.

PERMANENT FIX FOR THE INTERMITTENT BREAKAGE:
    Switch the VM from Bridged to Shared (NAT) networking in the Parallels GUI so
    the VM keeps a stable IP across network changes. See the header for details.
EOF
}

main() {
    case "${1:-}" in
        status) cmd_status ;;
        sync)   cmd_sync ;;
        files)  cmd_files ;;
        help|--help|-h) cmd_help ;;
        *) print_error "Unknown command: ${1:-<none>}"; echo; cmd_help; exit 1 ;;
    esac
}
main "$@"
